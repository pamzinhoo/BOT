# Discord
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=

# ID do servidor de teste (opcional). Se definido, os slash commands sincronizam
# instantaneamente so nesse servidor (sync global do Discord leva ate 1h pra
# propagar). Ative "Modo desenvolvedor" no Discord e clique com botao direito
# no icone do servidor > Copiar ID do Servidor.
TEST_GUILD_ID=

# Ambiente: development | production
ENVIRONMENT=development

# PostgreSQL (formato SQLAlchemy async)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/bot_limerence

# Logging
LOG_LEVEL=INFO

# --- Monetizacao / Gateway de pagamentos --------------------------------

# API HTTP interna (recebe webhooks do gateway). Roda no mesmo processo do bot.
API_HOST=127.0.0.1
API_PORT=8000

# URL publica que o gateway usa pra chamar de volta (webhook). Em dev local sem
# dominio, deixe o default (http://localhost:8000) — webhook nao vai chegar ate
# voce expor essa porta (ex: ngrok) ou apontar um dominio real de producao.
PUBLIC_BASE_URL=http://localhost:8000

# Rota /webhooks/mercadopago so processa notificacoes de verdade quando true.
# Em false (default), a rota existe mas so loga aviso de dev e ignora — seguro
# pra rodar local sem gateway configurado.
WEBHOOK_ENABLED=false

# sandbox (default, usa credenciais _SANDBOX abaixo) | production (usa _PRODUCTION)
PAYMENT_MODE=sandbox

# Credenciais do Mercado Pago (nunca commitar valores reais). Use as
# credenciais de TESTE da sua aplicacao MP para as variaveis _SANDBOX.
MERCADOPAGO_ACCESS_TOKEN_SANDBOX=
MERCADOPAGO_PUBLIC_KEY_SANDBOX=
MERCADOPAGO_WEBHOOK_SECRET_SANDBOX=

MERCADOPAGO_ACCESS_TOKEN_PRODUCTION=
MERCADOPAGO_PUBLIC_KEY_PRODUCTION=
MERCADOPAGO_WEBHOOK_SECRET_PRODUCTION=
