# Discord
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=

# ID do servidor de teste (opcional). Se definido, os slash commands sincronizam
# instantaneamente so nesse servidor (sync global do Discord leva ate 1h pra
# propagar). Ative "Modo desenvolvedor" no Discord e clique com botao direito
# no icone do servidor > Copiar ID do Servidor.
TEST_GUILD_ID=

# Ambiente: development | production
ENVIRONMENT=development

# PostgreSQL (formato SQLAlchemy async)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/bot_limerence

# Logging
LOG_LEVEL=INFO

# --- Monetizacao / Gateway de pagamentos --------------------------------

# API HTTP interna (recebe webhooks do gateway). Roda no mesmo processo do bot.
API_HOST=127.0.0.1
API_PORT=8000

# URL publica que o gateway usa pra chamar de volta (webhook). Em dev local sem
# dominio, deixe o default (http://localhost:8000) — webhook nao vai chegar ate
# voce expor essa porta (ex: ngrok) ou apontar um dominio real de producao.
PUBLIC_BASE_URL=http://localhost:8000

# Rota /webhooks/mercadopago so processa notificacoes de verdade quando true.
# Em false (default), a rota existe mas so loga aviso de dev e ignora — seguro
# pra rodar local sem gateway configurado.
WEBHOOK_ENABLED=false

# sandbox (default, usa credenciais _SANDBOX abaixo) | production (usa _PRODUCTION)
PAYMENT_MODE=sandbox

# Credenciais do Mercado Pago (nunca commitar valores reais). Use as
# credenciais de TESTE da sua aplicacao MP para as variaveis _SANDBOX.
MERCADOPAGO_ACCESS_TOKEN_SANDBOX=
MERCADOPAGO_PUBLIC_KEY_SANDBOX=
MERCADOPAGO_WEBHOOK_SECRET_SANDBOX=

MERCADOPAGO_ACCESS_TOKEN_PRODUCTION=
MERCADOPAGO_PUBLIC_KEY_PRODUCTION=
MERCADOPAGO_WEBHOOK_SECRET_PRODUCTION=

# --- Storage (download de DLC/base game/binario do Launcher) -----------

# r2 | s3 | b2 — so rotulo de auditoria/log, o comportamento e identico nos
# 3 (todos falam a API S3/SigV4). Quem muda de verdade e endpoint/credenciais.
STORAGE_PROVIDER=r2
STORAGE_BUCKET=
# Vazio = Amazon S3 real. Cloudflare R2: https://<account_id>.r2.cloudflarestorage.com
# Backblaze B2: https://s3.<region>.backblazeb2.com
STORAGE_ENDPOINT_URL=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Duracao (segundos) da URL assinada de download — sempre curta, nunca link permanente.
STORAGE_DOWNLOAD_TTL_SECONDS=600

# --- Canal interno Backend<->Bot (Fase 5) -------------------------------

# Segredo HMAC compartilhado que autentica POST /internal/* (eventos de
# licenca, reconciliacao sob demanda). Gere um valor aleatorio forte, nunca
# reutilize outro secret. Sem isso, /internal/* responde 503.
# Minimo 32 bytes (HS256, RFC 7518 3.2) — abaixo disso Settings.load() recusa subir.
INTERNAL_API_SECRET=

# --- Autenticacao (Discord OAuth + JWT) ---------------------------------

# App OAuth do Discord usada pelo fluxo de login do Launcher (PKCE + state,
# ver bot/api/routes/auth_routes.py). Client ID e publico por natureza do
# fluxo PKCE; Client Secret NUNCA deve ser embutido no bundle do Launcher —
# so o backend/bot usa. Crie em https://discord.com/developers/applications
# (pode ser a mesma app de DISCORD_APPLICATION_ID ou uma dedicada a OAuth).
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=

# URL de callback do OAuth. Vazio = derivado de PUBLIC_BASE_URL
# (`{PUBLIC_BASE_URL}/auth/discord/callback`) — so defina explicito se o
# callback registrado no Discord Developer Portal for diferente.
DISCORD_OAUTH_REDIRECT_URI=

# Segredo usado pra assinar/validar o JWT (HS256) emitido ao Launcher apos
# login — access token (JWT_ACCESS_TTL_SECONDS) + refresh token
# (REFRESH_TOKEN_TTL_DAYS, rotacao a cada uso, reuso detectado e revoga a
# sessao). Minimo 32 bytes (RFC 7518 3.2) — chave curta e forjavel por forca
# bruta offline, permitindo emitir token valido pra qualquer player.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
